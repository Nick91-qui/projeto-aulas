{
  "name": "projeto-aulas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:prisma:generate": "docker compose exec app npx prisma generate",
    "docker:prisma:migrate": "docker compose exec app npx prisma migrate dev",
    "docker:prisma:seed": "docker compose exec app npx prisma db seed",
    "docker:prisma:studio": "docker compose exec -d app npx prisma studio",
    "docker:test": "docker compose exec app npm test"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "20.19.37",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
